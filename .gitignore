# ============================================================
# Meridian - Visual Studio / .NET .gitignore
# ============================================================

# ------------------------------------------------------------
# Visual Studio temporary files
# ------------------------------------------------------------
.vs/

# ------------------------------------------------------------
# .NET build output
# IMPORTANT: Recursive rules prevent bin/obj folders from
# Meridian.Client, Meridian.Api, Meridian.Shared, etc.
# ------------------------------------------------------------
**/bin/
**/obj/

# ------------------------------------------------------------
# User-specific Visual Studio files
# ------------------------------------------------------------
*.user
*.suo
*.csproj.user
*.rsuser
*.userosscache
*.sln.docstates
*.userprefs

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# Build configurations
# ------------------------------------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

bld/
[Ll]og/
[Ll]ogs/

# ------------------------------------------------------------
# Test and build artifacts
# ------------------------------------------------------------
TestResults/
[Tt]est[Rr]esult*/
artifacts/
BenchmarkDotNet.Artifacts/

[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ------------------------------------------------------------
# .NET generated files
# ------------------------------------------------------------
project.lock.json
project.fragment.lock.json

*.dll
*.exe
*.pdb
*.cache
*.deps.json

# Do not ignore runtimeconfig files globally because some
# projects may intentionally track configuration files.

# ------------------------------------------------------------
# NuGet
# ------------------------------------------------------------
*.nupkg
*.snupkg

**/[Pp]ackages/*
!**/[Pp]ackages/build/

*.nuget.props
*.nuget.targets

# ------------------------------------------------------------
# Files built/generated by Visual Studio
# ------------------------------------------------------------
Generated\ Files/

*_i.c
*_p.c
*_h.h

*.ilk
*.meta
*.obj
*.iobj
*.pch
*.ipdb
*.pgc
*.pgd
*.rsp

# Keep directory-level MSBuild configuration
!Directory.Build.rsp

*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj

*.log
*.tlog

*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# ------------------------------------------------------------
# ASP.NET / publishing
# ------------------------------------------------------------
ScaffoldingReadMe.txt

publish/

*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

PublishScripts/

# ------------------------------------------------------------
# Visual Studio profiler / diagnostics
# ------------------------------------------------------------
*.psess
*.vsp
*.vspx
*.sap
*.e2e
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ------------------------------------------------------------
# Visual Studio extensions / tooling
# ------------------------------------------------------------

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover
*.dotCover

# AxoCover
.axoCover/*
!.axoCover/settings.json

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Chutzpah
_Chutzpah*

# StyleCop
StyleCopReport.xml

# Fody
FodyWeavers.xsd

# Local Visual Studio history
.localhistory/
.vshistory/

# ------------------------------------------------------------
# Visual C++ generated files
# ------------------------------------------------------------
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# ------------------------------------------------------------
# Node / JavaScript
# ------------------------------------------------------------
node_modules/
.ntvs_analysis.dat

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.pyc

# ------------------------------------------------------------
# VS Code
# ------------------------------------------------------------
.vscode/*

# Allow shared VS Code configuration if required
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.code-workspace
.history/

# ------------------------------------------------------------
# JetBrains Rider
# ------------------------------------------------------------
*.sln.iml
.idea/

# ------------------------------------------------------------
# SQL Server local database files
# ------------------------------------------------------------
*.mdf
*.ldf
*.ndf

# ------------------------------------------------------------
# Backup / upgrade files
# ------------------------------------------------------------
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# ------------------------------------------------------------
# Temporary / miscellaneous files
# ------------------------------------------------------------
ClientBin/

~$*
*~

*.dbmdl
*.dbproj.schemaview
*.jfm

# Certificate/private key files should not normally be
# committed to source control.
*.pfx

*.publishsettings
orleans.codegen.cs

# MSBuild logs
*.binlog

# ------------------------------------------------------------
# Windows
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini

$RECYCLE.BIN/

*.stackdump
*.lnk

# Windows installer files
*.cab
*.msi
*.msix
*.msm
*.msp

