<?xml version="1.0" encoding="utf-8"?>
<!--
  Merged by "dotnet publish" with the ASP.NET Core handler settings (the aspNetCore element is added automatically).

  Why this exists: Meridian asks Microsoft to come back with a plain GET (ResponseMode "query"), so the whole
  sign-in answer (authorization code + state + session info) arrives in the address. IIS refuses any address
  query longer than 2048 characters by default and shows a generic "404 - File or directory not found" page
  (IIS sub-status 404.15) before the app ever sees it. Some Microsoft accounts get longer codes than others,
  so sign-in worked for some people and not for others. These limits leave plenty of room.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="16384" maxUrl="4096" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
