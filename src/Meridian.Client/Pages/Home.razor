@page "/"
@attribute [Authorize]

@inject MeridianApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Meridian | Dashboard</PageTitle>

<div class="dash-page">

    <div class="dash-topbar">

        <div class="dash-brand">
            Meridian
        </div>

        <LoginDisplay />

    </div>


    @if (_loading)
    {
        <LoadingPanel Message="Loading dashboard..." />
    }
    else if (_error is not null)
    {
        <ErrorPanel Message="@_error" />
    }
    else if (_progress is not null)
    {
        <div class="dash-grid">

            <!-- =========================================
                 PROGRESS
            ========================================== -->

            <div class="dash-progress-col">

                <section class="block">

                    <h2>Your progress</h2>

                    <div class="arc-card">

                        <svg class="arc-svg"
                             viewBox="0 0 200 110"
                             aria-label="Progress arc">

                            <path class="arc-track"
                                  d="M20,100 A80,80 0 0 1 180,100">
                            </path>

                            <path class="arc-fill"
                                  d="M20,100 A80,80 0 0 1 180,100"
                                  style="stroke-dasharray:251.33;stroke-dashoffset:@ArcOffset">
                            </path>

                            <circle class="arc-sun"
                                    r="7"
                                    cx="@SunX"
                                    cy="@SunY">
                            </circle>

                        </svg>


                        <div class="arc-labels">
                            <span>Dawn</span>
                            <span>Meridian</span>
                        </div>


                        <!--
                            Rank is based on MONTHLY XP.
                            It automatically resets each month.
                        -->

                        <div class="arc-rank">
                            Current rank:
                            <span>@RankLabel</span>
                        </div>

                        <div class="rank-monthly-xp">
                            @_monthlyXp XP earned this month
                        </div>


                        <!--
                            CPD progress remains annual.
                            It does NOT reset every month.
                        -->

                        <div class="arc-stat">
                            @CompletedCpd / @AnnualCpdTarget
                            CPD points completed this year
                        </div>

                    </div>


                    <div class="streak-pill active">

                        <span class="streak-flame"></span>

                        <span>
                            @_progress.CurrentStreak-day streak
                        </span>

                    </div>

                </section>

            </div>


            <!-- =========================================
                 UPCOMING + COMPLETED QUIZZES
            ========================================== -->

            <div class="dash-quizzes-col">

                <!-- UPCOMING QUIZZES -->

                <section class="block">

                    <a class="dashboard-section-link"
                       href="quizzes">

                        <h2>Upcoming quizzes</h2>

                        <span class="view-all">
                            View all →
                        </span>

                    </a>


                    <div class="quiz-list">

                        @foreach (var quiz in UpcomingQuizzes)
                        {
                            var unlocked =
                                IsUnlocked(quiz);

                            <a class="quiz-card quiz-card-link @(unlocked ? "unlocked" : "locked")"
                               href="quizzes">

                                <div class="quiz-info">

                                    <span class="quiz-title">
                                        @quiz.Title
                                    </span>


                                    <span class="quiz-meta">

                                        <span class="quiz-tag">
                                            @quiz.Category
                                        </span>

                                        @quiz.CpdPoints CPD pts
                                        ·
                                        @quiz.QuestionsPerAttempt questions

                                    </span>


                                    @if (!unlocked &&
                                        quiz.AvailableFrom is DateTime availableFrom)
                                    {
                                        <span class="quiz-unlock-date">
                                            Unlocks
                                            @availableFrom.ToString("dd MMM yyyy")
                                        </span>
                                    }

                                </div>


                                <span class="quiz-start @(unlocked ? "" : "quiz-locked")">

                                    @(unlocked
                                        ? "Unlocked"
                                        : "Locked")

                                </span>

                            </a>
                        }

                    </div>

                </section>


                <!-- COMPLETED QUIZZES -->

                <section class="block completed-quizzes-block">

                    <h2>Completed quizzes</h2>


                    @if (_completedQuizzes.Count == 0)
                    {
                        <div class="empty-completed">
                            No completed quizzes yet.
                        </div>
                    }
                    else
                    {
                        <div class="quiz-list">

                            @foreach (var quiz in _completedQuizzes.Take(3))
                            {
                                <div class="quiz-card completed-quiz-card">

                                    <div class="quiz-info">

                                        <span class="quiz-title">
                                            @quiz.Title
                                        </span>


                                        <span class="quiz-meta">

                                            <span class="quiz-tag">
                                                @quiz.Category
                                            </span>

                                            Completed
                                            @quiz.CompletedAt.ToString("dd MMM yyyy")

                                        </span>

                                    </div>


                                    <div class="completed-result">

                                        <strong>
                                            @quiz.ScorePercent%
                                        </strong>

                                        <span>
                                            +@quiz.CpdPointsEarned CPD
                                        </span>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </section>

            </div>


            <!-- =========================================
                 YEARLY CHART
            ========================================== -->

            <div class="dash-chart-col">

                <section class="block">

                    <h2>
                        Modules completed this year
                    </h2>


                    <div class="chart-card">

                        <div class="bar-chart">

                            @foreach (var month in ChartData)
                            {
                                <div class="bar-col">

                                    <div class="bar"
                                         style="height:@month.Height%">
                                    </div>

                                    <span>
                                        @month.Label
                                    </span>

                                </div>
                            }

                        </div>

                    </div>

                </section>

            </div>

        </div>
    }

</div>


@code {

    // =============================================
    // Dashboard data
    // =============================================

    private UserProgressDto? _progress;

    private IReadOnlyList<QuizSummaryDto> _quizzes = [];

    private IReadOnlyList<CompletedQuizDto>
        _completedQuizzes = [];

    private bool _loading = true;

    private string? _error;


    // =============================================
    // Annual CPD progress
    // =============================================

    private const decimal AnnualCpdTarget = 18m;


    private decimal CompletedCpd =>
        Math.Min(
            AnnualCpdTarget,
            _progress is null
                ? 0
                : _progress.QuizzesPassed * 1.5m);


    private double Progress =>
        (double)(CompletedCpd / AnnualCpdTarget);


    private string ArcOffset =>
        (251.33 * (1 - Progress))
            .ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);


    private string SunX =>
        (100 + 80 *
            Math.Cos(
                Math.PI -
                Math.PI * Progress))
            .ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);


    private string SunY =>
        (100 - 80 *
            Math.Sin(
                Math.PI -
                Math.PI * Progress))
            .ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);


    // =============================================
    // Monthly XP / Current Rank
    // =============================================

    private int _monthlyXp;


    private string RankLabel =>
        GetCurrentRank(_monthlyXp);


    private static string GetCurrentRank(
        int monthlyXp)
    {
        return monthlyXp switch
        {
            >= 800 => "Meridian",

            >= 500 => "Zenith",

            >= 250 => "Ascent",

            _ => "Dawn"
        };
    }


    // =============================================
    // Upcoming quizzes
    // =============================================

    private IEnumerable<QuizSummaryDto>
        UpcomingQuizzes =>
            _quizzes
                .Where(
                    quiz =>
                        !_completedQuizzes.Any(
                            completed =>
                                completed.QuizId ==
                                quiz.Id))
                .OrderBy(
                    quiz =>
                        quiz.AvailableFrom ??
                        DateTime.MinValue)
                .Take(3);


    private static bool IsUnlocked(
        QuizSummaryDto quiz) =>
            quiz.AvailableFrom is null ||
            DateTime.Today >=
            quiz.AvailableFrom.Value.Date;


    // =============================================
    // Chart
    // =============================================

    private static readonly
        (string Label, int Height)[] ChartData =
        [
            ("Mar", 33),
            ("Apr", 50),
            ("May", 17),
            ("Jun", 67),
            ("Jul", 50),
            ("Aug", 33)
        ];


    // =============================================
    // Load dashboard
    // =============================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // -----------------------------------------
            // Annual progress
            // -----------------------------------------

            _progress =
                await Api.GetMyProgressAsync();


            // -----------------------------------------
            // Quiz data
            // -----------------------------------------

            _quizzes =
                await Api.GetQuizzesAsync();


            _completedQuizzes =
                await Api.GetCompletedQuizzesAsync();


            // -----------------------------------------
            // Get currently authenticated user's name
            // -----------------------------------------

            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();


            var currentUserName =
                authenticationState
                    .User
                    .Identity?
                    .Name;


            // -----------------------------------------
            // Load CURRENT MONTH leaderboard
            // -----------------------------------------

            var today =
                DateTime.Today;


            var monthlyLeaderboard =
                await Api.GetMonthlyLeaderboardAsync(
                    today.Year,
                    today.Month);


            // -----------------------------------------
            // Find current user in monthly leaderboard
            // -----------------------------------------

            if (!string.IsNullOrWhiteSpace(
                    currentUserName))
            {
                var currentUser =
                    monthlyLeaderboard
                        .FirstOrDefault(
                            entry =>
                                string.Equals(
                                    entry.DisplayName,
                                    currentUserName,
                                    StringComparison.OrdinalIgnoreCase));


                _monthlyXp =
                    currentUser?.MonthlyXp ?? 0;
            }
            else
            {
                _monthlyXp = 0;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}