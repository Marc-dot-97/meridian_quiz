@page "/"
@attribute [Authorize]

@inject MeridianApiClient Api
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Meridian | Dashboard</PageTitle>

<div class="dash-page">

    <div class="dash-topbar">

        <div class="dash-brand"
             style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">

            <BrandMark />

            <a href="reports" class="btn-arc btn-arc--primary btn-arc--export">
                <span>Export report (PDF)</span>
            </a>

            @if (_canCreateQuizzes)
            {
                <a href="quiz-builder" class="btn-arc btn-arc--quiz" title="Create a quiz"><span>+ Quiz</span></a>
            }
            <a href="surveys" class="btn-arc btn-arc--surveys" title="Create or manage surveys"><span>+ Surveys</span></a>
            <a href="assignments" class="btn-arc btn-arc--assign" title="Who has to do which quiz or survey"><span>Assignments</span></a>

        </div>

        <LoginDisplay />

    </div>


    @if (_loading)
    {
        <LoadingPanel Message="Loading dashboard..." />
    }
    else if (_error is not null)
    {
        <ErrorPanel Message="@_error" />
    }
    else if (_progress is not null)
    {
        <div class="dash-grid">

            <!-- =========================================
                 PROGRESS
            ========================================== -->

            <div class="dash-progress-col">

                <section class="block">

                    <a class="dashboard-section-link progress-section-link"
                       href="progress">

                        <h2>Your progress</h2>

                        <span class="view-all">
                            View progress →
                        </span>

                    </a>

                    <div class="arc-card">

                        <svg class="arc-svg"
                             viewBox="0 0 200 110"
                             aria-label="Progress arc">

                            <path class="arc-track"
                                  d="M20,100 A80,80 0 0 1 180,100">
                            </path>

                            <path class="arc-fill"
                                  d="M20,100 A80,80 0 0 1 180,100"
                                  style="stroke-dasharray:251.33;stroke-dashoffset:@ArcOffset">
                            </path>

                            <circle class="arc-sun"
                                    r="7"
                                    cx="@SunX"
                                    cy="@SunY">
                            </circle>

                        </svg>


                        <div class="arc-labels">
                            <span>Dawn</span>
                            <span>Meridian</span>
                        </div>


                        <!--
                            Rank is based on MONTHLY XP.
                            It automatically resets each month.
                        -->

                        <div class="arc-rank">
                            Current rank:
                            <span>@RankLabel</span>
                        </div>

                        <div class="rank-monthly-xp">
                            @_monthlyXp XP earned this month
                        </div>


                        <!--
                            CPD progress remains annual.
                            It does NOT reset every month.
                        -->

                        <div class="arc-stat">
                            @CompletedCpd / @AnnualCpdTarget
                            CPD points completed this year
                        </div>

                    </div>


                    <div class="streak-pill active">

                        <span class="streak-flame"></span>

                        <span>
                            @_progress.CurrentStreak-day streak
                        </span>

                    </div>

                </section>

            </div>


            <!-- =========================================
                 UPCOMING + COMPLETED QUIZZES
            ========================================== -->

            <div class="dash-quizzes-col">

                <!-- UPCOMING QUIZZES -->

                <section class="block">

                    <a class="dashboard-section-link"
                       href="quizzes">

                        <h2>Upcoming quizzes</h2>

                        <span class="view-all">
                            View all →
                        </span>

                    </a>


                    <div class="quiz-list">

                        @foreach (var quiz in UpcomingQuizzes)
                        {
                            var unlocked =
                                IsUnlocked(quiz);

                            <a class="quiz-card quiz-card-link @(unlocked ? "unlocked" : "locked")"
                               href="quizzes">

                                <div class="quiz-info">

                                    <span class="quiz-title">
                                        @quiz.Title
                                    </span>


                                    <span class="quiz-meta">

                                        <span class="quiz-tag">
                                            @quiz.Category
                                        </span>

                                        @quiz.CpdPoints CPD pts
                                        ·
                                        @quiz.QuestionsPerAttempt questions

                                    </span>

                                    <RequiredBadge Required="quiz.Required" DueOn="quiz.DueOn" />


                                    @if (quiz.ExpiresAt is DateTime end)
                                    {
                                        <span class="quiz-unlock-date">@(QuizAvailability.IsExpired(end) ? "Expired" : "Expires") @QuizAvailability.Display(end)</span>
                                    }
                                    @if (!unlocked && !QuizAvailability.IsExpired(quiz.ExpiresAt) &&
                                        quiz.AvailableFrom is DateTime availableFrom)
                                    {
                                        <span class="quiz-unlock-date">
                                            Unlocks
                                            @QuizAvailability.Display(availableFrom)
                                        </span>
                                    }

                                </div>


                                <span class="quiz-start @(unlocked ? "" : "quiz-locked")">

                                    @(unlocked
                                        ? "Unlocked"
                                        : QuizAvailability.IsExpired(quiz.ExpiresAt) ? "Expired" : "Locked")

                                </span>

                            </a>
                        }

                    </div>

                </section>


                <!-- COMPLETED QUIZZES -->

                <section class="block completed-quizzes-block">

                    <h2>Completed quizzes</h2>


                    @if (_completedQuizzes.Count == 0)
                    {
                        <div class="empty-completed">
                            No completed quizzes yet.
                        </div>
                    }
                    else
                    {
                        <div class="quiz-list">

                            @foreach (var quiz in _completedQuizzes.Take(3))
                            {
                                <div class="quiz-card completed-quiz-card">

                                    <div class="quiz-info">

                                        <span class="quiz-title">
                                            @quiz.Title
                                        </span>


                                        <span class="quiz-meta">

                                            <span class="quiz-tag">
                                                @quiz.Category
                                            </span>

                                            Completed
                                            @quiz.CompletedAt.ToString("dd MMM yyyy")

                                        </span>

                                    </div>


                                    <div class="completed-result">

                                        <strong>
                                            @quiz.ScorePercent%
                                        </strong>

                                        <span>
                                            +@quiz.CpdPointsEarned CPD
                                        </span>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </section>

            </div>

            <div class="dash-surveys-col">
                <DashboardSurveys />
            </div>


            <!-- =========================================
                 YEARLY CHART
            ========================================== -->

            <div class="dash-chart-col">

                <section class="block">

                    <a class="dashboard-section-link"
                       href="leaderboard">

                        <h2>
                            Modules completed this year
                        </h2>

                        <span class="view-all">
                            View leaderboard →
                        </span>

                    </a>


                    <div class="chart-card">

                        <div class="bar-chart">

                            @foreach (var month in ChartData)
                            {
                                <div class="bar-col">

                                    <div class="bar"
                                         style="height:@month.Height%">
                                    </div>

                                    <span>
                                        @month.Label
                                    </span>

                                </div>
                            }

                        </div>

                    </div>

                </section>

            </div>

        </div>
    }

</div>


@code {

    // =============================================
    // Dashboard data
    // =============================================

    private UserProgressDto? _progress;

    private IReadOnlyList<QuizSummaryDto> _quizzes = [];

    private IReadOnlyList<CompletedQuizDto>
        _completedQuizzes = [];

    private bool _loading = true;

    private string? _error;


    // =============================================
    // Annual CPD progress
    // =============================================

    private const decimal AnnualCpdTarget = 18m;


    private decimal CompletedCpd => _completedQuizzes
        .Where(q => q.CompletedAt.Year == DateTime.UtcNow.Year).Sum(q => q.CpdPointsEarned);

    private double Progress => (double)Math.Clamp(CompletedCpd / AnnualCpdTarget, 0m, 1m);

    private string ArcOffset =>
        (251.33 * (1 - Progress))
            .ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);


    private string SunX =>
        (100 + 80 *
            Math.Cos(
                Math.PI -
                Math.PI * Progress))
            .ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);


    private string SunY =>
        (100 - 80 *
            Math.Sin(
                Math.PI -
                Math.PI * Progress))
            .ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);


    // =============================================
    // Monthly XP / Current Rank
    // =============================================

    private int _monthlyXp;


    private string RankLabel =>
        GetCurrentRank(_monthlyXp);


    private static string GetCurrentRank(
        int monthlyXp)
    {
        return monthlyXp switch
        {
            >= 800 => "Meridian",

            >= 500 => "Zenith",

            >= 250 => "Intermediate",

            _ => "Beginner"
        };
    }


    // =============================================
    // Upcoming quizzes
    // =============================================

    private IEnumerable<QuizSummaryDto>
        UpcomingQuizzes =>
            _quizzes
                .Where(quiz => !QuizAvailability.IsExpired(quiz.ExpiresAt))
                .Where(
                    quiz =>
                        !_completedQuizzes.Any(
                            completed =>
                                completed.QuizId ==
                                quiz.Id))
                // Assigned to my department first (earliest due date first), then by unlock date.
                .OrderByDescending(quiz => quiz.Required)
                .ThenBy(quiz => quiz.DueOn ?? DateOnly.MaxValue)
                .ThenBy(
                    quiz =>
                        quiz.AvailableFrom ??
                        DateTime.MinValue)
                .Take(3);


    private static bool IsUnlocked(
        QuizSummaryDto quiz) =>
            QuizAvailability.CanStart(quiz.AvailableFrom, quiz.ExpiresAt);


    // =============================================
    // Chart
    // =============================================

    private (string Label, int Height)[] ChartData => Enumerable.Range(1, 12)
        .Select(m => (new DateTime(DateTime.UtcNow.Year, m, 1).ToString("MMM"),
            Math.Min(100, (int)(_completedQuizzes.Where(q => q.CompletedAt.Year == DateTime.UtcNow.Year && q.CompletedAt.Month == m).Sum(q => q.CpdPointsEarned) * 10))))
        .ToArray();

    // =============================================
    // Load dashboard
    // =============================================

    // Quiz creation is limited to SuperAdmin, HR and line managers (the server enforces it too).
    private bool _canCreateQuizzes;

    protected override async Task OnInitializedAsync()
    {
        try { _canCreateQuizzes = (await Http.GetFromJsonAsync<ReportAccessDto>("api/reports/access"))?.CanCreateQuizzes == true; }
        catch { _canCreateQuizzes = false; }

        try
        {
            // -----------------------------------------
            // Annual progress
            // -----------------------------------------

            _progress =
                await Api.GetMyProgressAsync();


            // -----------------------------------------
            // Quiz data
            // -----------------------------------------

            _quizzes =
                await Api.GetQuizzesAsync();


            _completedQuizzes =
                await Api.GetCompletedQuizzesAsync();


            // -----------------------------------------
            // Get currently authenticated user's name
            // -----------------------------------------

            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();


            var currentUserId = authenticationState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;


            // -----------------------------------------
            // Load CURRENT MONTH leaderboard
            // -----------------------------------------

            var today =
                DateTime.Today;


            var monthlyLeaderboard =
                await Api.GetMonthlyLeaderboardAsync(
                    today.Year,
                    today.Month);


            // -----------------------------------------
            // Find current user in monthly leaderboard
            // -----------------------------------------

            if (!string.IsNullOrWhiteSpace(
                    currentUserId))
            {
                var currentUser =
                    monthlyLeaderboard
                        .FirstOrDefault(
                            entry =>
                                entry.UserId.ToString() == currentUserId);


                _monthlyXp =
                    currentUser?.MonthlyXp ?? 0;
            }
            else
            {
                _monthlyXp = 0;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }



}