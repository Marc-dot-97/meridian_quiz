@page "/login"
@attribute [AllowAnonymous]
@layout AuthLayout
@inject LocalAccountService Accounts
@inject NavigationManager Navigation

<PageTitle>Meridian | Sign in</PageTitle>

<div class="login-screen">
    <svg class="login-ambient-arc" viewBox="0 0 200 110" aria-hidden="true">
        <path d="M10,100 A90,90 0 0 1 190,100" fill="none" stroke="var(--muted-orange)" stroke-width="1" />
    </svg>

    <div class="login-content auth-panel">
        <h1 class="login-wordmark">Meridian</h1>
        <p class="login-tagline">Learn, grow and share your voice</p>

            @if (!string.IsNullOrWhiteSpace(Message))
            {
                <div class="auth-error" role="alert">@Message</div>
            }

            @if (MicrosoftAvailable)
            {
                <button class="quiz-start auth-submit" type="button" disabled="@Busy" @onclick="SignInWithMicrosoft">
                    @(Busy ? "Opening Microsoft…" : "Sign in with Microsoft")
                </button>
                <p class="auth-switch">Use your Optimum work account, the same one you use for the CRM.</p>
            }
            else
            {
                <div class="auth-error" role="alert">Microsoft sign-in is not set up on this server yet.</div>
            }

            @if (DevBypass)
            {
                @* DEV BYPASS: only rendered when the API reports it is enabled (never on production). *@
                <div class="dev-bypass" style="margin-top:20px; padding:12px; border:1px dashed var(--muted-orange); border-radius:8px;">
                    <div style="font-size:0.7rem; letter-spacing:0.08em; text-transform:uppercase; opacity:0.8; margin-bottom:8px;">Dev bypass · local / dev only</div>
                    <input class="auth-input" placeholder="Optional: sign in as this email" @bind="DevEmail" autocomplete="off" />
                    <button class="quiz-start auth-submit" type="button" style="margin-top:8px;" disabled="@Busy" @onclick="DevSignInAsync">
                        @(string.IsNullOrWhiteSpace(DevEmail) ? "Dev sign-in (Dev Admin)" : "Dev sign-in as user")
                    </button>
                    <div style="display:flex; gap:8px; margin-top:8px; flex-wrap:wrap;">
                        <button class="quiz-start" type="button" style="flex:1; font-size:0.75rem;" disabled="@Busy" @onclick="() => SeedAsync(false, false)">Seed dummy data</button>
                        <button class="quiz-start" type="button" style="flex:1; font-size:0.75rem;" disabled="@Busy" @onclick="() => SeedAsync(true, false)">Reset seed</button>
                        <button class="quiz-start" type="button" style="flex:1; font-size:0.75rem;" disabled="@Busy" @onclick="() => SeedAsync(false, true)">Clear seed</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(SeedMessage))
                    {
                        <div style="margin-top:8px; font-size:0.75rem; opacity:0.85;">@SeedMessage</div>
                    }
                </div>
            }
    </div>

    <p class="login-footer">MERIDIAN · PRIMEBRIDGE</p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private bool Busy;
    private bool DevBypass;
    private bool MicrosoftAvailable = true;
    private string? DevEmail;
    private string? Error;
    private string? SeedMessage;

    private string? Message => Error ?? ErrorCode switch
    {
        "noaccess" => "Your Microsoft account is not on the Optimum employee list, or is switched off. If you should have access, ask HR or IT to check your details in the CRM.",
        "failed" => "Microsoft sign-in did not complete. Please try again.",
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        DevBypass = await Accounts.DevBypassAvailableAsync();
        MicrosoftAvailable = await Accounts.MicrosoftSignInAvailableAsync();
    }

    // Full page load on purpose: /auth/login is a server endpoint that redirects to Microsoft, not a Blazor page.
    private void SignInWithMicrosoft()
    {
        Busy = true;
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "auth/login" : $"auth/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        Navigation.NavigateTo(target, forceLoad: true);
    }

    private async Task SeedAsync(bool reset, bool clearOnly)
    {
        if (Busy) return;
        Busy = true;
        Error = null;
        SeedMessage = clearOnly ? "Clearing seed data…" : "Seeding…";
        try { SeedMessage = await Accounts.SeedAsync(reset, clearOnly); }
        catch (Exception ex) { SeedMessage = null; Error = ex.Message; }
        finally { Busy = false; }
    }

    private async Task DevSignInAsync()
    {
        if (Busy) return;
        Busy = true;
        Error = null;
        try { await Accounts.DevLoginAsync(DevEmail); Navigation.NavigateTo("/", forceLoad: true); }
        catch (Exception ex) { Error = ex.Message; }
        finally { Busy = false; }
    }
}
