@page "/login"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject LocalAccountService LocalAccounts

<PageTitle>Sign in | Meridian</PageTitle>

<div class="login-screen">
    <svg class="login-ambient-arc" viewBox="0 0 700 300" aria-hidden="true">
        <ellipse cx="350" cy="70" rx="300" ry="190" fill="none" stroke="currentColor" stroke-width="2" />
        <ellipse cx="350" cy="70" rx="245" ry="145" fill="none" stroke="currentColor" stroke-width="1" />
    </svg>

    <section class="login-content auth-card">
        <p class="auth-eyebrow">OPTIMUM FINANCIAL SERVICES GROUP</p>
        <h1 class="login-wordmark">Meridian</h1>
        <p class="login-tagline">Professional development, progress and CPD learning in one place.</p>

        @if (UseLocalMode)
        {
            <EditForm Model="Model" OnValidSubmit="HandleLocalLogin" class="auth-form">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="auth-error" role="alert">@_error</div>
                }

                <div class="auth-field">
                    <label for="login-email">Email address</label>
                    <InputText id="login-email" class="auth-input" @bind-Value="Model.Email" autocomplete="email" />
                    <ValidationMessage For="@(() => Model.Email)" />
                </div>

                <div class="auth-field">
                    <label for="login-password">Password</label>
                    <InputText id="login-password" class="auth-input" type="password" @bind-Value="Model.Password" autocomplete="current-password" />
                    <ValidationMessage For="@(() => Model.Password)" />
                </div>

                <button type="submit" class="auth-primary-btn" disabled="@_submitting">
                    @(_submitting ? "Signing in..." : "Sign in")
                </button>
            </EditForm>

            <div class="demo-credentials">
                <strong>Local demo account</strong>
                <span>local@meridian.test</span>
                <span>Password: Meridian123!</span>
            </div>
        }
        else
        {
            <button type="button" class="ms-signin-btn" @onclick="SignInWithMicrosoft">
                <span class="ms-mark" aria-hidden="true">M</span>
                Sign in with Microsoft
            </button>
        }

        <p class="auth-switch">
            New to Meridian?
            <a href="register">Create an account</a>
        </p>

        <p class="login-footer">Meridian · CPD Learning Platform</p>
    </section>
</div>

@code {
    private readonly LoginModel Model = new()
    {
        Email = "local@meridian.test"
    };

    private bool UseLocalMode => Configuration.GetValue<bool>("Development:UseLocalMode");
    private bool _submitting;
    private string? _error;

    private async Task HandleLocalLogin()
    {
        _submitting = true;
        _error = null;

        try
        {
            var result = await LocalAccounts.LoginAsync(Model.Email, Model.Password);

            if (!result.Success)
            {
                _error = result.ErrorMessage;
                return;
            }

            Navigation.NavigateTo("/");
        }
        finally
        {
            _submitting = false;
        }
    }

    private void SignInWithMicrosoft()
        => Navigation.NavigateToLogin("authentication/login");

    private sealed class LoginModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
