@page "/register"
@attribute [AllowAnonymous]
@layout AuthLayout

@using Meridian.Client.Models

@inject LocalAccountService Accounts
@inject UserApiClient UserApi
@inject NavigationManager Navigation

<PageTitle>Meridian | Register</PageTitle>

<div class="login-screen">

    <svg class="login-ambient-arc"
         viewBox="0 0 200 110"
         aria-hidden="true">

        <path d="M10,100 A90,90 0 0 1 190,100"
              fill="none"
              stroke="var(--muted-orange)"
              stroke-width="1" />

    </svg>

    <div class="login-content auth-panel register-panel">

        <h1 class="login-wordmark">
            Create account
        </h1>

        <p class="login-tagline">
            Register your Meridian profile.
        </p>

        <EditForm Model="@Model"
                  OnValidSubmit="RegisterAsync"
                  class="auth-form">

            <DataAnnotationsValidator />

            <div class="auth-two-col">

                <div>
                    <label>First name</label>

                    <InputText class="auth-input"
                               @bind-Value="Model.FirstName" />

                    <ValidationMessage For="@(() => Model.FirstName)" />
                </div>

                <div>
                    <label>Surname</label>

                    <InputText class="auth-input"
                               @bind-Value="Model.LastName" />

                    <ValidationMessage For="@(() => Model.LastName)" />
                </div>

            </div>


            <!-- Work email -->

            <label>Work email</label>

            <InputText class="auth-input"
                       @bind-Value="Model.Email" />

            <ValidationMessage For="@(() => Model.Email)" />


            <!-- Department -->

            <label>Department</label>

            <InputSelect class="auth-input"
                         @bind-Value="Model.Department"
                         @bind-Value:after="DepartmentChanged">

                <option value="">
                    Select department
                </option>

                @foreach (var department in DepartmentRoles.Keys)
                {
                    <option value="@department">
                        @department
                    </option>
                }

            </InputSelect>

            <ValidationMessage For="@(() => Model.Department)" />


            <!-- Role
                 Only appears once a department has been selected -->
            @if (!string.IsNullOrWhiteSpace(Model.Department))
            {
                <label>Role</label>

                <InputSelect class="auth-input"
                             @bind-Value="Model.UserRole">

                    <option value="">
                        Select role
                    </option>

                    @foreach (var role in AvailableRoles)
                    {
                        <option value="@role">
                            @role
                        </option>
                    }

                </InputSelect>

                <ValidationMessage For="@(() => Model.UserRole)" />
            }


            <!-- Line manager -->

            <label>Line manager</label>

            <InputText class="auth-input"
                       @bind-Value="Model.LineManager" />


            <!-- Passwords -->

            <div class="auth-two-col">

                <div>
                    <label>Password</label>

                    <InputText class="auth-input"
                               type="password"
                               @bind-Value="Model.Password" />

                    <ValidationMessage For="@(() => Model.Password)" />
                </div>

                <div>
                    <label>Confirm password</label>

                    <InputText class="auth-input"
                               type="password"
                               @bind-Value="Model.ConfirmPassword" />

                    <ValidationMessage For="@(() => Model.ConfirmPassword)" />
                </div>

            </div>


            <ValidationSummary />


            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="auth-error">
                    @Error
                </div>
            }


            @if (!string.IsNullOrWhiteSpace(Success))
            {
                <div class="auth-success">
                    @Success
                </div>
            }


            <button class="quiz-start auth-submit"
                    type="submit"
                    disabled="@IsSaving">

                @if (IsSaving)
                {
                    <span>Creating account...</span>
                }
                else
                {
                    <span>Create account</span>
                }

            </button>

        </EditForm>


        <p class="auth-switch">
            Already registered?

            <a href="login">
                Sign in
            </a>
        </p>

    </div>

</div>


@code {

    private RegisterModel Model { get; } = new();

    private string? Error;

    private string? Success;

    private bool IsSaving;


    // -------------------------------------------------
    // Department / Role selection
    // -------------------------------------------------

    private IReadOnlyList<string> AvailableRoles =>
        DepartmentRoles.TryGetValue(
            Model.Department,
            out var roles)
                ? roles
                : [];


    private void DepartmentChanged()
    {
        // Clear the old role whenever the user changes
        // department so an invalid role cannot carry over.
        Model.UserRole = string.Empty;
    }


    private static readonly Dictionary<string, string[]>
        DepartmentRoles = new()
        {
            ["Optimum Direct Solutions (Pty) Ltd"] =
            [
                "Financial Advisor",
                "Regional Manager",
                "Administrator"
            ],


            ["Optimum Shared Services (Pty) Ltd"] =
            [
                "Chief Executive Officer (CEO)",
                "Chief Financial Officer (CFO)",
                "Chief Operating Officer (COO)",
                "Finance Manager",
                "Financial Accountant",
                "Group Financial Accountant",
                "Human Resource Assistant",
                "Head Of Human Resource",
                "Head Of IT",
                "Senior IT Support",
                "IT Support",
                "Software Developer",
                "Legal Assistant",
                "Marketing Manager",
                "Brand Manager",
                "Personal Assistant",
                "Office Cleaner",
                "Receptionist",
                "Driver"
            ],


            ["Optimum Employee Benefits (Pty) Ltd"] =
            [
                "Employee Benefits Consultant",
                "Employee Benefits Administrator",
                "Employee Benefits Manager"
            ],


            ["Optimum Insure Consulting (Pty) Ltd"] =
            [
                "Account Executive",
                "Financial Advisor"
            ],


            ["Optimum Professional Financial Planning (Pty) Ltd"] =
            [
                "New Business Assistant",
                "Profile Assistant",
                "Sevicing Assistant",
                "Financial Advisor",
                "Franchise",
                "Hybrid / Private Wealth",
                "Executive Head",
                "Operational Manager",
                "Healthcare Administator",
                "Healthcare Financial Advisor"
            ],


            ["Real Broker Solutions"] =
            [
                "Claims Consultant",
                "Claims Manager",
                "Senior Commercial Underwriter",
                "HCV Underwriter",
                "Underwriting Manager",
                "Personal Lines Underwriter",
                "HCV Support",
                "HCV Claims",
                "Commercial Underwriter",
                "Junior Underwriter"
            ],


            ["Optimum Investment Group (Pty) Ltd"] =
            [
                "Advisor Consultant Manager",
                "Advisor Consultant",
                "Business Development Manager",
                "Head of Distribution",
                "Head of Manager Research",
                "Portfolio Specialist",
                "Junior Advisor Consultant",
                "Junior Analyst",
                "Intern",
                "Equity Analyst",
                "Portfolio Manager",
                "Marketing Manager",
                "Head Of Marketing",
                "Operations Analyst",
                "Office Manager",
                "Portfolio Operations Analyst",
                "Risk Analyst"
            ]
        };


    // -------------------------------------------------
    // Registration
    // -------------------------------------------------

    private async Task RegisterAsync()
    {
        Error = null;
        Success = null;


        // ---------------------------------------------
        // Check department
        // ---------------------------------------------

        if (string.IsNullOrWhiteSpace(Model.Department))
        {
            Error = "Please select a department.";
            return;
        }


        // ---------------------------------------------
        // Check role
        // ---------------------------------------------

        if (string.IsNullOrWhiteSpace(Model.UserRole))
        {
            Error = "Please select a role.";
            return;
        }


        // ---------------------------------------------
        // Make sure the role actually belongs
        // to the selected department.
        // ---------------------------------------------

        if (!AvailableRoles.Contains(Model.UserRole))
        {
            Error =
                "The selected role is not valid for this department.";

            return;
        }


        // ---------------------------------------------
        // Check passwords
        // ---------------------------------------------

        if (Model.Password != Model.ConfirmPassword)
        {
            Error = "Passwords do not match.";
            return;
        }


        IsSaving = true;


        try
        {
            // ---------------------------------------------
            // Build username from email
            // ---------------------------------------------

            var userName =
                CreateUserName(Model.Email);


            // ---------------------------------------------
            // Create request for Meridian.Api
            // ---------------------------------------------

            var request = new CreateUserRequest
            {
                UserName = userName,

                Email =
                    Model.Email.Trim(),

                FirstName =
                    Model.FirstName.Trim(),

                LastName =
                    Model.LastName.Trim(),

                Department =
                    Model.Department.Trim(),

                UserRole =
                    Model.UserRole.Trim()
            };


            // ---------------------------------------------
            // REAL DATABASE SAVE
            //
            // Meridian.Client
            //       ↓
            // POST /api/users
            //       ↓
            // Meridian.Api
            //       ↓
            // MySQL
            // ---------------------------------------------

            var createdUser =
                await UserApi.CreateUserAsync(request);


            // ---------------------------------------------
            // LOCAL DEVELOPMENT LOGIN
            //
            // Password and line manager are currently
            // only used by our temporary local login.
            // ---------------------------------------------

            var localRegistration =
                new LocalRegistration(
                    Model.FirstName,
                    Model.LastName,
                    Model.Email,
                    Model.Department,
                    Model.LineManager,
                    Model.Password);


            if (!Accounts.TryRegister(
                    localRegistration,
                    out var localError))
            {
                Error =
                    $"The user was saved to the database, " +
                    $"but the local login could not be created. " +
                    $"{localError}";

                return;
            }


            // ---------------------------------------------
            // Success
            // ---------------------------------------------

            Success =
                $"Account created successfully. " +
                $"User ID: {createdUser.Id}";


            // Small delay so the success message can appear.
            await Task.Delay(700);


            // LocalAccountService has authenticated the user.
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }


    // -------------------------------------------------
    // Username helper
    // -------------------------------------------------

    private static string CreateUserName(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "user";
        }

        var atIndex =
            email.IndexOf('@');

        var userName =
            atIndex > 0
                ? email[..atIndex]
                : email;

        userName = userName.Trim();


        // MySQL UserName column is varchar(50).
        if (userName.Length > 50)
        {
            userName =
                userName[..50];
        }


        return userName;
    }


    // -------------------------------------------------
    // Register form model
    // -------------------------------------------------

    private sealed class RegisterModel
    {
        [Required]
        public string FirstName { get; set; } =
            string.Empty;


        [Required]
        public string LastName { get; set; } =
            string.Empty;


        [Required]
        [EmailAddress]
        public string Email { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage = "Please select a department.")]
        public string Department { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage = "Please select a role.")]
        public string UserRole { get; set; } =
            string.Empty;


        public string LineManager { get; set; } =
            string.Empty;


        [Required]
        [MinLength(8)]
        public string Password { get; set; } =
            string.Empty;


        [Required]
        public string ConfirmPassword { get; set; } =
            string.Empty;
    }
}